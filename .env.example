# ============================================================
# CONFIGURAÇÃO DO SERVIDOR
# Copie este arquivo para `.env` e preencha os valores.
# ============================================================

# URL onde a aplicação está hospedada.
# Usada para links internos e endpoints da API.
APP_URL="https://app.igrejarenovar.com"

# ------------------------------------------------------------
# OBRIGATÓRIO EM PRODUÇÃO
# ------------------------------------------------------------

# Chave que assina os tokens de login. Mínimo de 32 caracteres.
# Em produção (NODE_ENV=production) o servidor NÃO SOBE sem ela.
# Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ------------------------------------------------------------
# PRIMEIRO ACESSO (opcional)
# ------------------------------------------------------------

# Login e senha do Super Administrador criado na primeira execução.
# Se SUPERADMIN_PASSWORD ficar vazia, o servidor sorteia uma senha e a
# exibe UMA VEZ no log de inicialização. Nos dois casos, a troca de senha
# é exigida no primeiro acesso.
SUPERADMIN_EMAIL="admin"
SUPERADMIN_PASSWORD=

# ------------------------------------------------------------
# HOSPEDAGEM
# ------------------------------------------------------------

# Defina como "true" se o servidor estiver atrás de nginx, Cloudflare ou
# outro proxy reverso. Sem isso o limite de tentativas de login enxerga o
# IP do proxy no lugar do IP real do usuário.
TRUST_PROXY=false

# Porta do servidor (padrão: 3000)
PORT=3000

# ------------------------------------------------------------
# META WHATSAPP BUSINESS API
# ------------------------------------------------------------

# TOKEN: fornecido pelo Portal Meta Business
WHATSAPP_API_TOKEN=
# PHONE_NUMBER_ID: id do número que envia as mensagens
WHATSAPP_PHONE_NUMBER_ID=
