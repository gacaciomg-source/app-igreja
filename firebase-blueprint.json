{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "member", "superadmin", "leader"] },
        "avatar": { "type": "string", "format": "uri" },
        "birthDate": { "type": "string" },
        "leaderOf": { "type": "string" },
        "cellIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "notificationSettings": {
          "type": "object",
          "properties": {
            "wordOfDayEnabled": { "type": "boolean" },
            "wordOfDayTime": { "type": "string" },
            "newSermonEnabled": { "type": "boolean" },
            "allMuted": { "type": "boolean" }
          }
        }
      },
      "required": ["name", "email", "role"]
    },
    "Event": {
      "title": "Event",
      "description": "Church event information",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "time", "location", "category"]
    },
    "PrayerRequest": {
      "title": "PrayerRequest",
      "description": "Prayer request from a user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "user": { "type": "string" },
        "content": { "type": "string" },
        "privacy": { "type": "string", "enum": ["public", "private"] },
        "cellIds": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string" },
        "likes": { "type": "integer" },
        "comments": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["user", "content"]
    },
    "CellGroup": {
      "title": "CellGroup",
      "description": "Church cell group information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "leader": { "type": "string" },
        "day": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "members": { "type": "integer" },
        "membersList": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "leader", "day", "time", "location"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "number" },
        "type": { "type": "string", "enum": ["in", "out"] },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["label", "value", "type"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Attendance record for a cell group",
      "type": "object",
      "properties": {
        "cellId": { "type": "string" },
        "date": { "type": "string" },
        "presentMembers": { "type": "array", "items": { "type": "string" } },
        "absentMembers": { "type": "array", "items": { "type": "string" } },
        "visitorsCount": { "type": "integer" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["cellId", "date", "presentMembers", "absentMembers"]
    },
    "ReadingPlan": {
      "title": "ReadingPlan",
      "description": "Bible reading plan",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "duration": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "chapters": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "description", "duration", "chapters"]
    },
    "Sermon": {
      "title": "Sermon",
      "description": "A church sermon or message",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "preacher": { "type": "string" },
        "date": { "type": "string" },
        "videoUrl": { "type": "string", "format": "uri" },
        "audioUrl": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "thumbnail": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "preacher", "date", "description"]
    },
    "VerseHighlight": {
      "title": "VerseHighlight",
      "description": "A colored highlight for a Bible verse",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "book": { "type": "string" },
        "chapter": { "type": "integer" },
        "verse": { "type": "integer" },
        "color": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "book", "chapter", "verse", "color", "text"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "A church announcement or news item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "date": { "type": "string" },
        "author": { "type": "string" }
      },
      "required": ["title", "content", "date", "author"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/events/{eventId}": { "schema": "Event", "description": "Church events" },
    "/prayers/{prayerId}": { "schema": "PrayerRequest", "description": "Prayer wall" },
    "/cells/{cellId}": { "schema": "CellGroup", "description": "Cell groups" },
    "/readingPlans/{planId}": { "schema": "ReadingPlan", "description": "Bible reading plans" },
    "/userProgress/{userId}": { "schema": "object", "description": "User reading progress" },
    "/transactions/{transactionId}": { "schema": "Transaction", "description": "Financial transactions" },
    "/attendance/{attendanceId}": { "schema": "Attendance", "description": "Cell attendance records" },
    "/verseHighlights/{highlightId}": { "schema": "VerseHighlight", "description": "User Bible highlights" },
    "/sermons/{sermonId}": { "schema": "Sermon", "description": "Church sermons" },
    "/announcements/{announcementId}": { "schema": "Announcement", "description": "Church announcements" }
  }
}
